# HoneyTrap Environment Variables Example
HONEYTRAP_SENSOR_ID=honeytrap-01
HONEYTRAP_DATA_DIR=data
HONEYTRAP_DB_PATH=data/honeytrap.db

# SSH Honeypot
HONEYTRAP_SSH_ENABLED=true
HONEYTRAP_SSH_PORT=2222
HONEYTRAP_SSH_HOST_KEY_FILE=data/ssh_host_key
HONEYTRAP_SSH_BANNER="SSH-2.0-OpenSSH_8.9p1 Ubuntu-3ubuntu0.4"
HONEYTRAP_SSH_MAX_AUTH_ATTEMPTS=6

# HTTP Honeypot
HONEYTRAP_HTTP_ENABLED=true
HONEYTRAP_HTTP_PORT=8080
HONEYTRAP_HTTP_SERVER_HEADER="Apache/2.4.54 (Ubuntu)"

# FTP Honeypot
HONEYTRAP_FTP_ENABLED=true
HONEYTRAP_FTP_PORT=2121
HONEYTRAP_FTP_BANNER="220 (vsFTPd 3.0.5)"
HONEYTRAP_FTP_PASV_PORT_RANGE=30000-30100

# API / Dashboard
HONEYTRAP_API_HOST=0.0.0.0
HONEYTRAP_API_PORT=3000
HONEYTRAP_API_CORS_ORIGINS="*"

# GeoIP Lookup
HONEYTRAP_GEO_ENABLED=true
HONEYTRAP_GEO_CACHE_TTL=86400
